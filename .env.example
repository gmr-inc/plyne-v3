# Plyne v3 env contract (see src/config/env.ts for the source of truth).

# --- Claude model selection ---
PLYNE_CLAUDE_MODEL=claude-opus-4-8
PLYNE_EXTENDED_THINKING=true

# --- Anthropic auth ---
# Either a long-lived API key OR rely on the user-level OAuth Max session
# the `claude` CLI keeps in ~/.claude/. Set this only for headless / CI.
ANTHROPIC_API_KEY=

# --- Notion (task source) ---
NOTION_TOKEN=
NOTION_TASKS_DB_ID=

# --- Runtime knobs ---
CLAUDE_CLI_PATH=/usr/bin/claude
WORKTREE_BASE=/tmp/plyne-v3-worktrees
POLL_INTERVAL_MS=15000
MAX_CONCURRENT_TASKS=3
API_PORT=7733

# Shared bearer secret used by plyne-app's `/api/v1/activity` proxy to
# connect to the daemon's `/activity/stream` SSE endpoint. Generate with
# `openssl rand -hex 32`. When empty, the SSE handler returns 503
# (intentional fail-loud — never silently allow unauthenticated streaming).
PLYNE_DAEMON_API_TOKEN=

# --- V3 isolation ---
# Only pick tasks whose external_id starts with this prefix. v3 runs in
# parallel to v2 on the same Notion DB; this is how we keep them apart
# during the test-flight phase.
PLYNE_V3_TASK_PREFIX=V3-TEST-

# --- Boot mode ---
# `daemon` (default) — polling loop. `smoke` — start API only, runner stays off.
PLYNE_MODE=daemon

LOG_LEVEL=info

# --- MCP server passthrough (optional) ---
# stack-loader picks these up if a task config requests the matching MCP.
# GH_TOKEN / SUPABASE_ACCESS_TOKEN are also validated at boot via
# src/config/boot-validation.ts (live API ping when present).
GH_TOKEN=
GITHUB_TOKEN=
VERCEL_TOKEN=
SUPABASE_ACCESS_TOKEN=

# --- Telegram (optional, alerts) ---
# When set, verified at boot via api.telegram.org/getMe.
TELEGRAM_BOT_TOKEN=

# --- plyne-app Supabase (optional, LIVE reporter + notifications) ---
# Project ref jwduoitebqncgaqrappk. When BOTH are set, v3 mirrors task status
# into public.tasks (by notion_page_id) and upserts public.daemon_heartbeat so
# the plyne.dev FE reflects daemon progress live (Supabase realtime). Also
# powers the public.notifications UI bell. When unset, all of this no-ops with
# a warn — the daemon boots and runs normally, the FE just won't see progress.
PLYNE_APP_SUPABASE_URL=https://jwduoitebqncgaqrappk.supabase.co
PLYNE_APP_SUPABASE_SERVICE_ROLE_KEY=

# --- Vercel env pull (single source of truth) ---
# When `PLYNE_V3_PULL_VERCEL_ENV=true`, the daemon fetches env vars from the
# Vercel API at boot (project prj_ga3mQEEC546h5afE8d2g3oo95DCl, "plyne-evidence")
# and populates process.env BEFORE the Zod schema runs. Local .env still wins
# for keys explicitly set — Vercel only fills in unset keys. Falls back
# gracefully on Vercel API failure (offline-friendly).
PLYNE_V3_PULL_VERCEL_ENV=false
# Override the deployment target (default: production). Use "preview" for debug.
PLYNE_V3_VERCEL_ENV_TARGET=production
# Set if the Vercel project lives under a team (not personal scope).
VERCEL_TEAM_ID=
